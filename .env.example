# Copy this file to .env and fill in what you need. Never share or zip your .env.
# With no changes at all, Medibot runs fully OFFLINE (local AI model + on-screen OTP).

# --- Required ---------------------------------------------------------------
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# --- Offline mode / AI model ---------------------------------------------------
OFFLINE_MODE=true
# ollama = local AI on this computer, no internet (default)
# groq   = Groq cloud API (needs internet + GROQ_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
# Only for LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600

# --- SMS / OTP -----------------------------------------------------------------
# auto = real SMS to the user's phone via Fast2SMS (India) first, then Twilio,
#        using whichever keys are filled in below. With no keys, or no internet,
#        the OTP is shown on the screen instead (offline mode).
SMS_PROVIDER=auto
SMS_FALLBACK=true
# Set to false once real SMS works, so codes are never displayed on screen.
SHOW_OTP_ON_SCREEN=true

# Fast2SMS (India) - see readme.txt "GETTING A FAST2SMS KEY"
FAST2SMS_API_KEY=
# q = Quick SMS (works right after a recharge), otp = OTP route (needs website verification)
FAST2SMS_ROUTE=q

# Twilio (any country) - see readme.txt "GETTING TWILIO KEYS"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

DEFAULT_COUNTRY_CODE=+91
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# --- Login security --------------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_LIFETIME_DAYS=7
# Set to true when the site is served over HTTPS
SESSION_COOKIE_SECURE=false

# --- Retrieval ---------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_DIR=models/all-MiniLM-L6-v2
RETRIEVER_K=4
CHAT_HISTORY_TURNS=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Paths (relative to the project folder) -------------------------------------------
DATA_PATH=Data
DB_FAISS_PATH=vectorstore/db_faiss
USER_DB_PATH=database/medibot.db
DISEASE_DB_PATH=database/diseases.db
LOGS_DIR=logs
